// Treino de Begging no Evermore (OrionUO), 2026-10-15.
//
// Como usar: fique numa cidade (de preferencia perto de joalheiros, magos, alquimistas, bardos, armadores
// de navios, arquitetos) e rode a funcao BeggingTrainer. O script procura NPCs num raio de SearchRange tiles,
// anda ate o melhor deles e pede esmola; enquanto a skill esta em espera, ja anda ate o proximo.
//
// Regras do Begging no Evermore (pkg\skills\begging):
//  - a skill so pode ser usada a cada 10 s; alcance de 3 tiles com linha de visao;
//  - cada tentativa de verdade (sucesso ou falha) da chance de subir a skill; quanto mais rico o NPC, mais sobe:
//      ricos (upper, dificuldade 75): alchemist, appraiser (real estate broker), architect, bard, jeweler, mage, shipwright
//      medios (middle, 45): armorer, blacksmith, bowyer, butcher, carpenter, healer, herbalist, mapmaker,
//                           provisioner, scribe, tailor, tinker, weaponsmith...
//      pobres (poor, 10): baker, banker, barkeep, cook, farmer, fisherman, innkeeper, stablemaster...
//    Por isso o script prefere os ricos, depois os medios e por ultimo os pobres (e o mais perto entre iguais);
//  - o mesmo NPC so da de novo para voce 10 min depois de dar (e isso nao conta como tentativa);
//  - a bolsa do NPC esvazia com as esmolas e se recupera aos poucos (bolsa vazia tambem nao conta);
//  - karma negativo: ninguem da nada (cada esmola tira 2 de karma, mas nunca abaixo de 0).
//  NPCs que acabaram de dar, com bolsa vazia ou que nao da para alcancar ficam de lado por um tempo.

var MsgColor = '0x0030';
var ErrColor = '0x0026';
var Humans = '0x0190|0x0191';
var SearchRange = 18;        // raio de busca de NPCs (tiles)
var BegRange = 2;            // chega a ate 2 tiles (o Begging aceita 3)
var SkillDelay = 10500;      // 10 s entre usos da skill (+ folga)
var RestMinutes = 10;        // NPC que deu ou esta sem bolsa fica de lado
var UnreachableMinutes = 3;  // NPC que nao deu para alcancar fica de lado

// titulos dos NPCs por riqueza (o nome do NPC termina com "the <titulo>")
var Upper = /the (jeweler|mage|alchemist|bard|shipwright|architect|real estate broker)$/i;
var Middle = /the (armorer|blacksmith|bowyer|butcher|carpenter|healer|herbalist|mapmaker|provisioner|scribe|tailor|tinker|weaponsmith|weaver|leatherworker|barber)$/i;
var AnyNpc = / the /i;

// respostas que nao contam como tentativa: deixa o NPC de lado
var NoTry = "I already gave thee something|Sorry, gave it all away already|Nope. Gots nothing|Your cohorts cleaned me out|Ain't got nothin'|No' got nothin'|Not much better off|Maybe ye can spare|I can give thee nothing|pockets in this armor|Not while I'm on duty|Perhaps talking to them|You look a little silly";
var Gave = 'throws a few coins|You quickly stuff|You miss and the coins';
var BadKarma = 'I will not give money to such as thee|Take off, eh|naughty evildoers';
var TooFar = 'You must be closer to beg';

var resting = {};            // serial -> Orion.Now() ate quando fica de lado
var nextUse = 0;             // quando a skill pode ser usada de novo


function BeggingTrainer()
{
	Orion.Print(MsgColor, 'Begging trainer started (searching ' + SearchRange + ' tiles around you).');
	var tries = 0, idle = 0;
	while (!Player.Dead())
	{
		var npc = PickNpc();
		if (!npc)
		{
			if (idle++ % 6 == 0)
				Orion.Print(ErrColor, 'No NPC to beg within ' + SearchRange + ' tiles. Move to another part of town.');
			Orion.Wait(5000);
			continue;
		}
		idle = 0;
		var serial = npc.Serial();

		// anda ate o NPC (enquanto a skill esta em espera, se for o caso)
		if (!WalkToNpc(serial))
		{
			Rest(serial, UnreachableMinutes);
			continue;
		}

		// espera a skill liberar, seguindo o NPC se ele andar
		while (Orion.Now() < nextUse)
		{
			if (Orion.GetDistance(serial) > BegRange)
				WalkToNpc(serial);
			Orion.Wait(250);
		}
		if (!Orion.FindObject(serial) || Orion.GetDistance(serial) > 3)
			continue;

		Orion.ClearJournal();
		var start = Orion.Now();
		Orion.UseSkill('Begging');
		if (!Orion.WaitForTarget(2000))
		{
			nextUse = Orion.Now() + 1000;	// skill ainda em espera
			continue;
		}
		Orion.TargetObject(serial);
		nextUse = start + SkillDelay;
		Orion.Wait(1800);

		if (Orion.InJournal(BadKarma, '', '0', 'any', start))
		{
			Orion.Print(ErrColor, 'Your karma is negative: nobody will give you anything. Stopping.');
			return;
		}
		if (Orion.InJournal(TooFar, '', '0', 'any', start))
			continue;	// o NPC andou: tenta de novo
		if (Orion.InJournal(NoTry, '', '0', 'any', start))
		{
			Rest(serial, RestMinutes);
			continue;
		}
		tries++;
		if (Orion.InJournal(Gave, '', '0', 'any', start))
			Rest(serial, RestMinutes);	// o mesmo NPC so da de novo em 10 min
		if (tries % 10 == 0)
			Orion.Print(MsgColor, tries + ' tries. Begging: ' + (Orion.SkillValue('Begging', 'real') / 10));
	}
	Orion.Print(ErrColor, 'You are dead. Begging trainer stopped.');
}

// Anda ate ficar a BegRange tiles do NPC. Devolve false se nao conseguiu chegar.
function WalkToNpc(serial)
{
	var fails = 0;
	var last = Orion.GetDistance(serial);
	while (Orion.FindObject(serial) && Orion.GetDistance(serial) > BegRange)
	{
		var obj = Orion.FindObject(serial);
		Orion.WalkTo(obj.X(), obj.Y(), obj.Z(), 1, 255, false);
		Orion.Wait(400);
		var dist = Orion.GetDistance(serial);
		fails = dist >= last ? fails + 1 : 0;
		last = dist;
		if (fails >= 6 || Player.Dead())
			return false;
	}
	return !!Orion.FindObject(serial);
}

function Rest(serial, minutes)
{
	resting[serial] = Orion.Now() + minutes * 60000;
}

// NPC humano no raio de busca que nao esteja de lado: rico > medio > qualquer um com titulo; entre iguais, o mais perto
function PickNpc()
{
	var list = Orion.FindTypeEx(Humans, 'any', 'ground', 'mobile|live', SearchRange);
	var best = null, bestRank = 0, bestDist = 999;
	var now = Orion.Now();
	for (var i = 0; i < list.length; i++)
	{
		var m = list[i];
		var s = m.Serial();
		if (s == Player.Serial() || (resting[s] && resting[s] > now))
			continue;
		var name = m.Name();
		var rank = Upper.test(name) ? 3 : Middle.test(name) ? 2 : AnyNpc.test(name) ? 1 : 0;
		if (!rank)
			continue;
		var dist = Orion.GetDistance(s);
		if (rank > bestRank || (rank == bestRank && dist < bestDist))
		{
			best = m;
			bestRank = rank;
			bestDist = dist;
		}
	}
	return best;
}
